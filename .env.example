# DermAgent 环境变量模板
# 用法：cp .env.example .env，再按需填写；不要提交 .env。
# 根目录 .env 是唯一凭据文件（权限 0600）；服务端通过 server/data/local.env 软链读取它。
# 已存在的系统环境变量优先于本文件。

# ── 服务 ─────────────────────────────────────────────
# Web/桌面服务端口（默认 8765）
PORT=8765
# 运行数据目录（默认 web/backend/server/data）
# DERM_DATA_DIR=
# 桌面端指定拉起服务端用的 Python 解释器（默认自动探测）
# DERM_SERVER_PYTHON=

# ── 大模型（OpenAI 兼容 /chat/completions）────────────
# 不配置也能运行：走规则稿并标注 llm_unavailable，不生成医疗内容。
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=
# LLM_MODEL=
DERM_LLM_TIMEOUT_S=120

# ── MySQL（患者档案）──────────────────────────────────
# 全空时尝试读取 ~/.my.cnf；不可用则对应记忆层降级。
# DERM_MYSQL_HOST=127.0.0.1
DERM_MYSQL_PORT=3306
# DERM_MYSQL_USER=
# DERM_MYSQL_PASSWORD=
DERM_MYSQL_DB=dermagent

# ── Redis（短期会话窗口）──────────────────────────────
DERM_REDIS_URL=redis://127.0.0.1:6379/0

# ── Milvus（情景记忆 / 知识库向量）────────────────────
DERM_MILVUS_URI=http://127.0.0.1:19530
# DERM_MILVUS_TOKEN=

# ── MinerU（PDF/DOCX/EPUB 解析）───────────────────────
# 未配置 token 时 cloud 模式如实失败，不伪造入库。
# DERM_MINERU_TOKEN=
DERM_MINERU_BASE_URL=https://mineru.net/api/v4
DERM_MINERU_MODEL_VERSION=vlm
DERM_MINERU_LANGUAGE=ch
# auto / cloud / local
DERM_MINERU_MODE=auto
DERM_MINERU_POLL=5
DERM_MINERU_TIMEOUT=1800

# ── 知识库检索 ───────────────────────────────────────
DERM_KB_COLLECTION=derm_kb
DERM_KB_EMBED_MODEL=BAAI/bge-base-zh-v1.5
DERM_KB_RERANK_MODEL=BAAI/bge-reranker-base
DERM_KB_MILVUS_ALIAS=default
DERM_KB_MINERU_MODE=auto
# 总开关；设为 0 可关闭知识库
DERM_KB_ENABLED=1

# ── 记忆与摘要 ───────────────────────────────────────
DERM_MEMORY_ENABLED=1
# 1 = 允许用 LLM 生成上下文文字摘要（默认规则式摘要）
DERM_SUMMARY_LLM=0

# ── SSE 流式 ─────────────────────────────────────────
DERM_AGENT_STREAM=1
DERM_STREAM_HEARTBEAT_S=15

# ── 对外只读 MCP 桥（其他程序连 DermAgent）────────────
# 与本机「接入外部 MCP」是两条不同链路：此项默认关闭。
DERM_MCP=0
# 非空时要求 Authorization: Bearer <token>
# DERM_MCP_TOKEN=
